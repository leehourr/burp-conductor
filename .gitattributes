# Walkthroughs and reference docs are HTML by delivery format, not source code.
# Mark them as documentation so GitHub Linguist doesn't count them in the language bar.
research/*.html linguist-documentation
research/**/*.html linguist-documentation

# SVG diagrams in the README are documentation, not source.
assets/*.svg linguist-documentation

# Force every .md to be classified as Markdown. Phase-skill docs contain lots of
# <tag>-shaped tool-call syntax which Linguist's heuristics otherwise read as HTML.
*.md linguist-language=Markdown
*.md linguist-detectable=false
